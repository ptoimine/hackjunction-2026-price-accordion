# Copy to .env (git-ignored) and fill in. Never commit .env.
NVIDIA_API_KEY=            # NVIDIA Build API key (https://build.nvidia.com): Nemotron, used for /look and /coach
NEMOTRON_MODEL=            # exact model id from build.nvidia.com, e.g. nvidia/nemotron-3.5-super-vl-120b-a12b
CONTEXT_DEV_API_KEY=       # Context.dev key (https://docs.context.dev): live prices from Finnish shops and dealers
