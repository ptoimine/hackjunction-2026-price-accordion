<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Entitlements a FREE Apple Personal Team can sign. No Wi-Fi/Hotspot capabilities, so the
	     glasses' video stream cannot start; the Mock Device and Bluetooth/audio still work.
	     Use only via: CODE_SIGN_ENTITLEMENTS=PriceSense/PriceSense.freeteam.entitlements -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)$(CFBundleIdentifier)</string>
	</array>
</dict>
</plist>
